[Unit]
Description=OM System / Olympus camera tethering daemon (real-time photo dump)
Documentation=https://github.com/n0p/om-tether
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# pon aquí la IP de tu cámara (o 192.168.0.10 si usas su propio punto de
# acceso); el daemon reintenta solo si la cámara cambia de IP o se cae
ExecStart=/usr/bin/omtether daemon --host 192.168.0.10 \
    --out %h/Pictures/omtether \
    --state %h/.local/state/omtether/daemon.json \
    --keepalive 10 --poll 2
Restart=always
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=default.target
